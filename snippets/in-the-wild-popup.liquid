{%- comment -%}
  Quick-buy popup for the "In the wild" section.
  Options are rendered from the product's own data:
  - options whose name contains "color"/"colour" → color boxes (radio buttons)
  - every other option → dropdown (custom listbox)

  Accepts:
  - product {Product}
  - popup_id {String} Unique id, e.g. WildPopup-<block id>
  - button_label {String}
  - sold_out_label {String}
  - placeholder_prefix {String} e.g. "Choose your"
{%- endcomment -%}

{%- liquid
  assign popup_image = product.featured_image
  assign initial_variant = product.selected_or_first_available_variant
  assign description = product.description | strip_html | strip | truncatewords: 30
-%}

<dialog
  class="wild-popup"
  id="{{ popup_id }}"
  aria-labelledby="{{ popup_id }}-title"
  data-wild-popup
  data-product-id="{{ product.id }}"
>
  <button type="button" class="wild-popup__close" aria-label="Close" data-wild-close>
    <svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true" focusable="false">
      <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  </button>

  <div class="wild-popup__top">
    <div class="wild-popup__media">
      {%- if popup_image -%}
        {{
          popup_image
          | image_url: width: 480
          | image_tag: loading: 'lazy', class: 'wild-popup__image', sizes: '120px', widths: '240, 360, 480'
        }}
      {%- endif -%}
    </div>

    <div class="wild-popup__info">
      <h2 class="wild-popup__title" id="{{ popup_id }}-title">
        <span>{{ product.title | escape }}</span>
      </h2>
      <p class="wild-popup__price" data-wild-price>{{ product.price | money }}</p>
      {%- if description != blank -%}
        <p class="wild-popup__description">{{ description }}</p>
      {%- endif -%}
    </div>
  </div>

  <form
    class="wild-popup__form"
    action="{{ routes.cart_add_url }}"
    method="post"
    novalidate
    data-wild-form
  >
    <input
      type="hidden"
      name="id"
      value="{% if product.has_only_default_variant %}{{ initial_variant.id }}{% endif %}"
      data-wild-variant-id
    >

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        {%- liquid
          assign option_key = option.name | downcase
          assign option_index = forloop.index0
          assign input_name = popup_id | append: '-option-' | append: option.position
          assign single_value = false
          if option.values.size == 1
            assign single_value = true
          endif
        -%}

        {%- if option_key contains 'color' or option_key contains 'colour' -%}
          <fieldset
            class="wild-option"
            data-wild-option
            data-option-index="{{ option_index }}"
            data-option-name="{{ option.name | escape }}"
          >
            <legend class="wild-option__label">{{ option.name | escape }}</legend>
            <div class="wild-colors" style="--wild-color-cols: {{ option.values.size | at_most: 3 }};">
              {%- for value in option.values -%}
                {%- liquid
                  if value.swatch.color
                    assign swatch = value.swatch.color
                  else
                    # Falls back to a CSS colour keyword (white, black, grey, red…).
                    assign swatch = value.name | downcase | remove: ' '
                  endif
                -%}
                <label class="wild-color" data-wild-value="{{ value.name | escape }}">
                  <input
                    class="wild-color__input"
                    type="radio"
                    name="{{ input_name }}"
                    value="{{ value.name | escape }}"
                    {% if single_value %}checked{% endif %}
                  >
                  <span class="wild-color__stripe" style="--swatch: {{ swatch }};" aria-hidden="true"></span>
                  <span class="wild-color__name">{{ value.name | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- else -%}
          {%- liquid
            assign placeholder = placeholder_prefix | append: ' ' | append: option_key
            assign list_id = input_name | append: '-list'
            assign label_id = input_name | append: '-label'
            assign value_id = input_name | append: '-value'
          -%}
          <div
            class="wild-option wild-select"
            data-wild-option
            data-wild-select
            data-option-index="{{ option_index }}"
            data-option-name="{{ option.name | escape }}"
            {% if single_value %}data-selected="{{ option.values.first.name | escape }}"{% endif %}
          >
            <span class="wild-option__label" id="{{ label_id }}">{{ option.name | escape }}</span>
            <button
              type="button"
              class="wild-select__trigger"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="{{ list_id }}"
              aria-labelledby="{{ label_id }} {{ value_id }}"
              data-wild-select-trigger
            >
              <span
                class="wild-select__value{% unless single_value %} is-placeholder{% endunless %}"
                id="{{ value_id }}"
                data-placeholder="{{ placeholder | escape }}"
                data-wild-select-value
              >
                {%- if single_value -%}{{ option.values.first.name | escape }}{%- else -%}{{ placeholder | escape }}{%- endif -%}
              </span>
              <span class="wild-select__icon" aria-hidden="true">
                <svg viewBox="0 0 14 8" width="14" height="8" fill="none" focusable="false">
                  <path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </span>
            </button>
            <ul
              class="wild-select__list"
              id="{{ list_id }}"
              role="listbox"
              tabindex="-1"
              aria-labelledby="{{ label_id }}"
              hidden
              data-wild-select-list
            >
              {%- for value in option.values -%}
                <li
                  class="wild-select__option"
                  id="{{ list_id }}-{{ forloop.index }}"
                  role="option"
                  aria-selected="{% if single_value %}true{% else %}false{% endif %}"
                  data-wild-value="{{ value.name | escape }}"
                >
                  {{- value.name | escape -}}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}

    <button
      type="submit"
      class="wild-popup__submit"
      data-wild-submit
      {% unless product.available %}disabled{% endunless %}
    >
      <span data-wild-submit-label>
        {%- if product.available -%}{{ button_label | escape }}{%- else -%}{{ sold_out_label | escape }}{%- endif -%}
      </span>
      <svg class="wild-popup__submit-arrow" viewBox="0 0 36 12" fill="none" aria-hidden="true" focusable="false">
        <path d="M0 6h34.6M29.4 1l5.2 5-5.2 5" stroke="currentColor" stroke-width="1.3"/>
      </svg>
    </button>

    <p class="wild-popup__message" role="status" aria-live="polite" data-wild-message></p>
  </form>

  {%- comment -%}
    Variant data for the JS. Prices are pre-formatted with the store's money
    format so no currency formatting logic is needed in the browser.
  {%- endcomment -%}
  <script type="application/json" data-wild-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 480 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</dialog>
